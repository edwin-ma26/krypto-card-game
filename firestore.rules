rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms are joined by a short code, before either player has necessarily
    // signed in (playerID is a local device id, not a Firebase Auth uid), so
    // writes can't be gated on `request.auth`. Instead the create/update
    // rules pin the doc to the exact field set the app ever writes and cap
    // the two fields a spammer could otherwise inflate without limit (`hand`,
    // `players`) — closing off unbounded junk-document writes to this
    // collection without requiring sign-in.
    match /rooms/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'hand', 'target', 'round', 'host', 'status', 'mode', 'lockWindowSeconds',
        'hintsEnabled', 'undosAllowed', 'maxPlayers', 'createdAt', 'players', 'winner', 'hint',
        'lockedBy', 'lockedAt', 'cooldowns', 'liveSteps', 'solution',
        'rematchRequestedBy', 'rematchAccepted'
      ])
      && request.resource.data.hand is list && request.resource.data.hand.size() <= 10
      && request.resource.data.target is number
      && request.resource.data.host is string
      && request.resource.data.status == 'waiting'
      && request.resource.data.get('maxPlayers', 2) is number
      && request.resource.data.get('maxPlayers', 2) >= 2
      && request.resource.data.get('maxPlayers', 2) <= 6
      && request.resource.data.players is map && request.resource.data.players.size() <= 6;
      allow update: if request.resource.data.keys().hasOnly([
        'hand', 'target', 'round', 'host', 'status', 'mode', 'lockWindowSeconds',
        'hintsEnabled', 'undosAllowed', 'maxPlayers', 'createdAt', 'players', 'winner', 'hint',
        'lockedBy', 'lockedAt', 'cooldowns', 'liveSteps', 'solution',
        'rematchRequestedBy', 'rematchAccepted'
      ])
      && request.resource.data.players is map && request.resource.data.players.size() <= 6;
      allow delete: if true;
    }

    // One profile doc per authenticated user. Only the owner can write it;
    // reads are open so referral lookups and (future) leaderboards work.
    // A second, narrower rule lets any signed-in user mutate just the
    // `friends` field on someone else's doc, since adding/removing a friend
    // touches both accounts' arrays.
    match /users/{uid} {
      allow read: if true;

      // The owner may create/update/delete their own profile doc, with one
      // carve-out: `foundingPupStage` is written *only* by the
      // `onReferralCreated` Cloud Function (Admin SDK, which bypasses these
      // rules), so the badge's evolution always reflects the real referral
      // count and can't be forged with a hand-crafted write. `hasFoundingPup`
      // stays client-writable — it's earned offline on the pre-launch screen —
      // but can only ever move to `true`.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('foundingPupStage' in request.resource.data);
      // `soloRating` (Single Player's beat-the-clock rating) is written by
      // the client, so it can't be made tamper-proof here — but one write
      // can move it at most `SoloRating.maxSwing` (24) from its stored
      // value, never remove it, and must stay within 100…3000. A profile
      // that has never had the field may take any in-range value once: the
      // device-local rating a player built up before signing in.
      allow update: if request.auth != null && request.auth.uid == uid
                    && !('foundingPupStage' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                         !('hasFoundingPup' in request.resource.data.diff(resource.data).affectedKeys())
                         || request.resource.data.hasFoundingPup == true
                       )
                    && (
                         !('soloRating' in request.resource.data.diff(resource.data).affectedKeys())
                         || (
                              request.resource.data.soloRating is int
                              && request.resource.data.soloRating >= 100
                              && request.resource.data.soloRating <= 3000
                              && (
                                   !('soloRating' in resource.data)
                                   || (
                                        request.resource.data.soloRating <= resource.data.soloRating + 24
                                        && request.resource.data.soloRating >= resource.data.soloRating - 24
                                      )
                                 )
                            )
                       );
      allow delete: if request.auth != null && request.auth.uid == uid;

      // A second, narrower rule: any signed-in user may mutate just the
      // `friends` field on someone else's doc, since adding/removing a friend
      // touches both accounts' arrays.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']);

      // A pending friend request, doc id == sender's uid, living under the
      // recipient's own doc. Only the recipient may read/list their
      // requests; the sender may create their own request but nothing else;
      // either side may delete it (recipient on accept/decline, sender if a
      // future "cancel" is added).
      match /friendRequests/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == fromUid
                      && request.auth.uid != uid;
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid == fromUid);
      }

      // The player's own puzzle history (Profile › Stats), one doc per
      // finished solo deal, daily, or ranked match, written by the app and
      // mirrored across their devices. Private to the owner; append-only
      // apart from account deletion. Personal stats only — never read for a
      // leaderboard, so a hand-crafted entry can't affect anyone else.
      match /solves/{solveId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['kind', 'at', 'seconds', 'ratingAfter', 'delta', 'won'])
                      && request.resource.data.kind in ['solo', 'daily', 'ranked'];
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Maps a short referral code -> owning uid. Doc id is the code itself,
    // created once by its owner at sign-up and never mutated.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Maps a lowercased username -> owning uid, enforcing that usernames are
    // unique (case-insensitively). Doc id is the lowercased name. A user may
    // only claim a name for themselves, and may only release/rename a
    // reservation they already own — so nobody can squat or steal a name.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // One referral record per referred user (doc id == referredUid), so a
    // user can be referred at most once and can never credit themselves.
    match /referrals/{referredUid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == referredUid
                    && request.resource.data.referredUid == request.auth.uid
                    && request.resource.data.referrerUid != request.auth.uid;
      allow update, delete: if false;
    }

    // One matchmaking ticket per user. Clients may only create their own
    // "waiting" ticket and delete it (to cancel). Pairing — flipping a
    // ticket to "matched" — is done exclusively by the onQueueJoin Cloud
    // Function via the Admin SDK, which bypasses these rules entirely, so
    // no client update path is granted here at all.
    match /matchmakingQueue/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.status == 'waiting';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // A ranked race between two matched players. Only the onQueueJoin
    // Cloud Function creates these (Admin SDK, bypasses rules); clients
    // may only update shared progress/winner once they're a participant.
    match /rankedMatches/{matchId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null
                    && request.auth.uid in [resource.data.playerA, resource.data.playerB];
    }

    // Append-only share telemetry, one doc per completed share. The
    // coming-soon screen is shown to signed-out players, so creates can't
    // require auth — which means the worst a bad actor can do is add junk
    // rows. They can never read, alter or delete what's already there, so the
    // log stays trustworthy for anything you can filter (deviceId, version).
    // Read it from the console or with admin credentials, never the client.
    // In-app "Send Feedback" notes. Anyone (signed in or not) may add one;
    // nobody reads, edits or deletes from the client — triage them in the
    // console. Keys and message length are bounded so the worst case is
    // junk rows, never a vector for anything else.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly([
                      'kind', 'message', 'appVersion', 'device', 'osVersion', 'createdAt',
                      'contact', 'uid', 'displayName'
                    ])
                    && request.resource.data.kind in ['bug', 'idea', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 3
                    && request.resource.data.message.size() <= 2000
                    && (!('uid' in request.resource.data) || request.auth != null && request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if false;
    }

    match /shareEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // A pending friend challenge, one per recipient (doc id == their uid).
    // The sender creates/overwrites it to point at a room they already made;
    // the recipient deletes it once they've joined or dismissed it.
    match /challenges/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid != uid
                            && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The shared puzzle-of-the-day, doc id == UTC date ("YYYY-MM-DD"), plus a
    // "_meta" doc tracking recently-used puzzle ids so days don't repeat.
    // Dealt exclusively by the `generateDailyPuzzle` scheduled Cloud
    // Function (Admin SDK, bypasses rules) at UTC midnight, so every player
    // worldwide sees the same puzzle for the same date — clients only read.
    match /dailyPuzzles/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Aggregate telemetry for one puzzle combo (canonical hand+target),
    // pooled across every mode. Doc id encodes the hand/target, so it's not
    // itself sensitive; the only things worth guarding are that a write can't
    // introduce unknown fields or blow away another field while claiming to
    // "just" bump a counter. This is a low-stakes counters store (see
    // PuzzleStats.swift) — the worst a bad actor can do is skew a stat, the
    // same trust level already given to `rooms`.
    match /puzzleStats/{puzzleId} {
      allow read: if true;
      // `recordDealt` (the only call that ever creates this doc) writes just
      // `hand`/`target`/`timesDealt`/`updatedAt` — `timesSolved` isn't set
      // until a later `recordSolved` update, so it won't be present at
      // create time. Direct field access errors on a missing key, so this
      // goes through `get()` with a 0 default rather than requiring the key.
      allow create: if request.resource.data.keys().hasOnly([
        'hand', 'target', 'timesDealt', 'timesSolved', 'timesAbandoned',
        'totalSolveTimeMs', 'fastestSolveTimeMs', 'fastestSolveBy',
        'solveTimeBuckets', 'solveTimeBucketsV2', 'updatedAt'
      ])
      && request.resource.data.hand is list && request.resource.data.hand.size() <= 10
      && request.resource.data.target is number
      && request.resource.data.timesDealt is number && request.resource.data.timesDealt >= 0
      && request.resource.data.get('timesSolved', 0) is number && request.resource.data.get('timesSolved', 0) >= 0;
      // Same field allowlist as create, plus: counters may only move forward
      // (a bad actor can still skew a stat up, the trust level this store
      // already accepts — see comment above — but can no longer zero one out).
      // `resource.data.timesDealt`/`timesSolved` read the *pre-write* doc —
      // `recordDealt` never sets `timesSolved`, so a puzzle's first-ever
      // solve hits a doc that doesn't have that field yet. Dotting into a
      // missing key throws in rules (unlike returning null), which would
      // otherwise deny the whole update, so both reads go through `get()`
      // with a 0 default instead of direct field access.
      //
      // The `solveTimeBuckets.N` entries: app builds up to Nov 2026 wrote the
      // histogram bump as a dotted *string key* in a merge-set, which the
      // client SDK stores as a literal top-level field named
      // "solveTimeBuckets.N" rather than a nested map entry — so that's the
      // key `affectedKeys()` reports, and leaving it off this list silently
      // denied every `recordSolved` write (no solve was recorded from
      // 2026-08-28 until this fix). Newer builds write a proper nested map,
      // but these stay allowlisted so older installs keep recording.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'hand', 'target', 'timesDealt', 'timesSolved', 'timesAbandoned',
        'totalSolveTimeMs', 'fastestSolveTimeMs', 'fastestSolveBy',
        'solveTimeBuckets', 'solveTimeBucketsV2', 'updatedAt',
        'solveTimeBuckets.0', 'solveTimeBuckets.1', 'solveTimeBuckets.2', 'solveTimeBuckets.3',
        'solveTimeBuckets.4', 'solveTimeBuckets.5', 'solveTimeBuckets.6', 'solveTimeBuckets.7',
        'solveTimeBuckets.8', 'solveTimeBuckets.9', 'solveTimeBuckets.10', 'solveTimeBuckets.11',
        'solveTimeBuckets.12'
      ])
      && request.resource.data.get('timesDealt', 0) is number && request.resource.data.get('timesDealt', 0) >= resource.data.get('timesDealt', 0)
      && request.resource.data.get('timesSolved', 0) is number && request.resource.data.get('timesSolved', 0) >= resource.data.get('timesSolved', 0)
      && request.resource.data.get('timesAbandoned', 0) is number && request.resource.data.get('timesAbandoned', 0) >= resource.data.get('timesAbandoned', 0);
      allow delete: if false;

      // Sharded counters for the same puzzle (see `PuzzleStats.shardRef`):
      // clients spread their writes over `shards/{0…7}` so one popular
      // puzzle — the daily — isn't a single hot document that drops solves
      // under load. Same low-stakes trust level and the same field allowlist
      // as the parent, minus `hand`/`target` (the parent id carries those)
      // and the legacy dotted keys (no pre-shard build ever wrote here).
      // Counters may only move forward.
      match /shards/{shard} {
        allow read: if true;
        allow create: if shard.matches('^[0-9]$')
          && request.resource.data.keys().hasOnly([
            'timesDealt', 'timesSolved', 'timesAbandoned', 'totalSolveTimeMs',
            'fastestSolveTimeMs', 'fastestSolveBy', 'solveTimeBucketsV2', 'updatedAt'
          ])
          && request.resource.data.get('timesDealt', 0) is number && request.resource.data.get('timesDealt', 0) >= 0
          && request.resource.data.get('timesSolved', 0) is number && request.resource.data.get('timesSolved', 0) >= 0
          && request.resource.data.get('timesAbandoned', 0) is number && request.resource.data.get('timesAbandoned', 0) >= 0;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'timesDealt', 'timesSolved', 'timesAbandoned', 'totalSolveTimeMs',
            'fastestSolveTimeMs', 'fastestSolveBy', 'solveTimeBucketsV2', 'updatedAt'
          ])
          && request.resource.data.get('timesDealt', 0) is number && request.resource.data.get('timesDealt', 0) >= resource.data.get('timesDealt', 0)
          && request.resource.data.get('timesSolved', 0) is number && request.resource.data.get('timesSolved', 0) >= resource.data.get('timesSolved', 0)
          && request.resource.data.get('timesAbandoned', 0) is number && request.resource.data.get('timesAbandoned', 0) >= resource.data.get('timesAbandoned', 0);
        allow delete: if false;
      }
    }
  }
}
